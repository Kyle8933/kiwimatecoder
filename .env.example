# Optional: set a provider API key as an environment variable instead of using
# `kiwimatecoder config set-key`. Set whichever provider(s) you use; the env var
# takes precedence over a stored key.
OPENROUTER_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
# XAI_API_KEY=your_key_here
# MISTRAL_API_KEY=your_key_here
# DEEPSEEK_API_KEY=your_key_here
# DASHSCOPE_API_KEY=your_key_here
# MOONSHOT_API_KEY=your_key_here

# Local providers (ollama, lmstudio) need no key. Set these only if your local
# server enforces auth (e.g. an LM Studio server token or an authenticating
# proxy in front of Ollama).
# OLLAMA_API_KEY=your_key_here
# LMSTUDIO_API_KEY=your_key_here
